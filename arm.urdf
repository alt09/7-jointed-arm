<?xml version="1.0" ?>
<robot name="7jointed_arm">
  <!-- Base link / Gateway -->
  <link name="base_link">

    <visual> <!-- Base link visual -->
      <geometry>
        <box size="1 1 .01"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    
    <collision> <!-- Base link collision -->
      <geometry>
        <box size="1 1 .01"/>
      </geometry>
    </collision>

    <inertial> <!-- Base link inertial -->
      <mass value="1"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Shoulder Link 1 (Pitch) -->
  <joint name="shoulder_joint_1" type="revolute">
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="shoulder_link_1"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.124" upper="3.124" effort="100" velocity="1"/>
  </joint>
  <link name="shoulder_link_1">

    <visual> <!-- Shoulder link visual -->
      <geometry>
        <cylinder radius="0.23" length="0.2"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>

    <collision> <!-- Shoulder link collision -->
      <geometry>
        <cylinder radius="0.23" length="0.2"/>
      </geometry>
    </collision>

    <inertial> <!-- Shoulder link inertial -->
      <mass value="2"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Shoulder Link 2 (Yaw) -->
  <joint name="shoulder_joint_2" type="revolute">
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <parent link="shoulder_link_1"/>
    <child link="shoulder_link_2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="1"/>
  </joint>
  <link name="shoulder_link_2">

    <visual> <!-- Shoulder link visual -->
      <geometry>
        <cylinder radius="0.23" length="0.2"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>

    <collision> <!-- Shoulder link collision -->
      <geometry>
        <cylinder radius="0.23" length="0.2"/>
      </geometry>
    </collision>

    <inertial> <!-- Shoulder link inertial -->
      <mass value="2"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Shoulder Link 3 (Roll) -->
  <joint name="shoulder_joint_3" type="revolute">
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <parent link="shoulder_link_2"/>
    <child link="shoulder_link_3"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="1"/>
  </joint>
  <link name="shoulder_link_3">

    <visual> <!-- Shoulder link visual -->
      <geometry>
        <cylinder radius="0.23" length="0.2"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>

    <collision> <!-- Shoulder link collision -->
      <geometry>
        <cylinder radius="0.23" length="0.2"/>
      </geometry>
    </collision>

    <inertial> <!-- Shoulder link inertial -->
      <mass value="1.5"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>

  </link>

  <!-- Elbow Link (1 joint) -->
  <joint name="elbow_joint" type="revolute">
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <parent link="shoulder_link_3"/>
    <child link="elbow_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="100" velocity="1"/>
  </joint>
  <link name="elbow_link">

    <visual> <!-- Elbow link visual -->
      <geometry>
        <cylinder radius="0.23" length="0.25"/>
      </geometry>
      <material name="green">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>

    <collision> <!-- Elbow link collision -->
      <geometry>
        <cylinder radius="0.23" length="0.25"/>
      </geometry>
    </collision>

    <inertial> <!-- Elbow link inertial -->
      <mass value="1.5"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Wrist Link 1 (Pitch) -->
  <joint name="wrist_joint_1" type="revolute">
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <parent link="elbow_link"/>
    <child link="wrist_link_1"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="50" velocity="1"/>
  </joint>
  <link name="wrist_link_1">

    <visual> <!-- Wrist link visual -->
      <geometry>
        <cylinder radius="0.23" length="0.15"/>
      </geometry>
      <material name="yellow">
        <color rgba="1 1 0 1"/>
      </material>
    </visual>

    <collision> <!-- Wrist link collision -->
      <geometry>
        <cylinder radius="0.23" length="0.15"/>
      </geometry>
    </collision>

    <inertial> <!-- Wrist link inertial -->
      <mass value="1"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.05"/>
    </inertial>
  </link>

  <!-- Wrist Link 2 (Yaw) -->
  <joint name="wrist_joint_2" type="revolute">
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <parent link="wrist_link_1"/>
    <child link="wrist_link_2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="50" velocity="1"/>
  </joint>
  <link name="wrist_link_2">

    <visual> <!-- Wrist link visual -->
      <geometry>
        <cylinder radius="0.23" length="0.15"/>
      </geometry>
      <material name="yellow">
        <color rgba="1 1 0 1"/>
      </material>
    </visual>

    <collision> <!-- Wrist link collision -->
      <geometry>
        <cylinder radius="0.23" length="0.15"/>
      </geometry>
    </collision>

    <inertial> <!-- Wrist link inertial -->
      <mass value="1"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.05"/>
    </inertial>
  </link>

  <!-- Wrist Link 3 (Roll) -->
  <joint name="wrist_joint_3" type="revolute">
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <parent link="wrist_link_2"/>
    <child link="wrist_link_3"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="50" velocity="1"/>
  </joint>
  <link name="wrist_link_3">

    <visual> <!-- Wrist link visual -->
      <geometry>
        <cylinder radius="0.23" length="0.15"/>
      </geometry>
      <material name="yellow">
        <color rgba="1 1 0 1"/>
      </material>
    </visual>
    
    <collision> <!-- Wrist link collision -->
      <geometry>
        <cylinder radius="0.23" length="0.15"/>
      </geometry>
    </collision>

    <inertial> <!-- Wrist link inertial -->
      <mass value="0.8"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.05"/>
    </inertial>
  </link>

  <!-- End Effector -->
  <joint name="end_effector_joint" type="fixed">
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <parent link="wrist_link_3"/>
    <child link="end_effector"/>
  </joint>
  <link name="end_effector">

    <visual> <!-- End effector visual -->
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>

    <collision> <!-- End effector collision -->
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>

    <inertial> <!-- End effector inertial -->
      <mass value="0.2"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>

  </link>
</robot>
